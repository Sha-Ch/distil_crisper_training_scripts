# Copy to .env and fill in. docker-compose reads this file.
# NEVER commit your real .env (see .gitignore).

# HuggingFace token (required: gated datasets + avoids rate limiting)
HF_TOKEN=

# HuggingFace username (only needed if you enable push_to_hub)
HF_USERNAME=

# Weights & Biases key (optional; logging.use_wandb is false in config.local.yaml)
WANDB_API_KEY=

# -----------------------------------------------------------------------------
# Storage (docker-compose.yml): outputs -> TrueNAS SMB share; HF cache -> LOCAL.
# /workspace is the SMB share (CIFS); the HF cache is a local docker volume.
# Fill these in — the SMB share must exist before running, or the container fails fast.
# -----------------------------------------------------------------------------
SMB_HOST=192.168.1.55          # TrueNAS IP / hostname
SMB_SHARE=distil               # SMB share name for the dataset
SMB_USER=                      # SMB username
SMB_PASS=                      # SMB password (this file is gitignored — never commit it)

# hf_transfer: 0 = standard downloader (legible errors; recommended while validating),
# 1 = parallel/faster downloads once storage is confirmed stable.
HF_HUB_ENABLE_HF_TRANSFER=0

# NOTE: the legacy DATA_DIR bind-mount is no longer used — /workspace is now the SMB
# `workspace` volume and the HF cache is the local `hfcache` volume (docker-compose.yml).
